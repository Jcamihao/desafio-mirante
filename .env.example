# Copie para .env e preencha. O .env esta no .gitignore: NUNCA commite chaves.

# --- LLM ---------------------------------------------------------------------------------------
LLM_PROVIDER=gemini                 # gemini | anthropic
GOOGLE_API_KEY=                     # https://aistudio.google.com/apikey  (provider=gemini)
ANTHROPIC_API_KEY=                  # (provider=anthropic)
# Vazio => padrao do provedor (gemini: gemini-3.6-flash). Verificado em 2026-10-01: projetos novos
# NAO tem a familia gemini-2.5 (404 "no longer available to new users"); os Flash 3.x funcionam.
LLM_MODEL=
LLM_FALLBACK_MODELS=gemini-3.5-flash,gemini-3-flash-preview   # tentados na ordem se o principal falhar
# Resiliencia (valores padrao):
# LLM_TIMEOUT_S=120            timeout por chamada
# LLM_MAX_RETRIES=1            retries internos do SDK
# LLM_RETRY_ROUNDS=2           rodadas completas pela cadeia de modelos (picos de 503)
# LLM_ROUND_BACKOFF_S=20       espera entre rodadas
# LLM_MAX_RATE_LIMIT_WAIT_S=60 espera maxima ao honrar o "retry in Ns" de um 429 por minuto
# LLM_QUOTA_COOLDOWN_S=3600    modelo sem cota DIARIA e pulado por este tempo

# --- Pipeline ----------------------------------------------------------------------------------
# MAX_GENERATION_ATTEMPTS=3    1 geracao + ate 2 reparos guiados pela validacao
# MAX_CONCURRENT_RUNS=4        execucoes simultaneas (protege a cota do LLM)

# --- PostgreSQL da aplicacao (tabela modernization_history) --------------------------------------
# Servidor local (fora do compose), Postgres do compose exposto em localhost:5432:
DATABASE_URL=postgresql+psycopg://mirante:mirante@localhost:5432/mirante
# Dev sem Docker (Postgres embutido, ver scripts/dev_postgres.py):
# DATABASE_URL=postgresql+psycopg://postgres:@/mirante?host=/CAMINHO/DO/REPO/.pgdata
# Dentro do compose o servico `api` sobrescreve para o host `db`.

# --- Langfuse (self-hosted pelo docker compose) --------------------------------------------------
# Projeto, usuario e chaves abaixo sao criados automaticamente no 1o start (LANGFUSE_INIT_*).
# UI: http://localhost:3000  login: dev@mirante.local / mirante-dev-1234  (SOMENTE desenvolvimento)
LANGFUSE_ENABLED=true               # so liga de fato se as duas chaves existirem
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-mirante-local
LANGFUSE_SECRET_KEY=sk-lf-mirante-local
